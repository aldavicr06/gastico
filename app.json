{
  "expo": {
    "name": "Gastico",
    "slug": "gastico",
    "owner": "aldavi89s-team",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "scheme": "gastico",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gastico.app"
    },
    "android": {
      "package": "com.gastico.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E9F6E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Gastico usa la cámara para leer el total de tus facturas.",
          "photosPermission": "Gastico necesita tus fotos para leer facturas guardadas."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "b16f5706-702f-474d-98ca-215c134e76a3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b16f5706-702f-474d-98ca-215c134e76a3"
    }
  }
}
