{
  "expo": {
    "name": "Gastico",
    "slug": "gastico",
    "version": "1.0.0",
    "scheme": "gastico",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gastico.app"
    },
    "android": {
      "package": "com.gastico.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E9F6E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Gastico usa la c\u00e1mara para leer el total de tus facturas.",
          "photosPermission": "Gastico necesita tus fotos para leer facturas guardadas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
